# Discord Bot Token (Required)
DISCORD_TOKEN=your_bot_token_here

# Developer Admin User ID (Optional)
# Set your Discord user ID (or multiple separated by commas) to grant full bot admin
# privileges across all servers, including test environments where you do not have Admin permissions.
ADMIN_USER_ID=

